# 是否打开mock
VITE_USE_MOCK = true

# 发布路径
VITE_PUBLIC_PATH = '/'


# 跨域代理，您可以配置多个 ,请注意，没有换行符
# VITE_PROXY = [["/jeecgboot/bems","http://47.95.156.86:59999/sgai-bems/bems"],["/jeecgboot","http://47.95.156.86:59999/jeecg-system"],["/upload","http://127.0.0.1:3300/upload"],["/spsdomain","http://10.77.16.5/spsdomain"]]
#VITE_PROXY = [["/jeecg-bt/bems","http://192.168.204.51:9999/sgai-bems-baotou/bems"],["/jeecg-bt","http://192.168.204.51:9999/jeecg-bt"],["/upload","http://127.0.0.1:3300/upload"],["/spsdomain","http://10.77.16.5/spsdomain"]]
VITE_PROXY = [["/jeecg-bt/bems","http://192.168.204.51:9999/sgai-bems-baotou-dev/bems"],["/jeecg-bt","http://192.168.204.51:9999/jeecg-bt"],["/upload","http://127.0.0.1:3300/upload"],["/spsdomain","http://10.77.16.5/spsdomain"]]


#后台接口全路径地址(必填)
# VITE_GLOB_DOMAIN_URL=http://47.95.156.86:59999/jeecgboot
VITE_GLOB_DOMAIN_URL=http://192.168.204.51:9999/jeecg-bt

#后台接口父地址(必填)
# VITE_GLOB_API_URL=/jeecgboot
VITE_GLOB_API_URL=/jeecg-bt
VITE_GLOB_SPSDOMAIN_URL=/spsdomain
# 接口前缀
VITE_GLOB_API_URL_PREFIX=

#微前端qiankun应用,命名必须以VITE_APP_SUB_开头,jeecg-app-1为子应用的项目名称,也是子应用的路由父路径
VITE_APP_SUB_jeecg-app-1 = '//localhost:8092'
